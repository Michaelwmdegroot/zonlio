# Instellingen worden op de server ingevuld; nooit echte waarden committen.
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
SQLITE_PATH=.data/zonlio.sqlite

# Productie gebruikt MySQL. Een SQLite-bestand in een buildmap is niet geschikt.
# Productie op Hostinger: doorgaans 127.0.0.1; lokaal leeg laten voor SQLite.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

ADMIN_EMAIL=info@zonlio.nl
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=

# Publieke juridische naam bevestigd door eigenaar; nooit historische aanvragen herschrijven.
LEAD_CONTROLLER_NAME=NIVO Groep Holland BV
LEAD_CONTROLLER_EMAIL=info@zonlio.nl
LEAD_CONTROLLER_CONFIRMED=false
# Algemene adviesroute is onafhankelijk van accounts en woningadvies.
LEAD_ENABLED=false
# Apart vrijgeven na juridische en productiecontroles; een deploy zet dit nooit aan.
HOUSING_ADVICE_ENABLED=false
# NIVO internal notification only: the separate Portal agent owns later processing.
# Known legacy Hostinger LEAD_NOTIFY_TO=info@zonlio.nl auto-migrates to this inbox.
# Any other explicit custom address still overrides the default; check actual value privately in /admin.
LEAD_NOTIFY_TO=portal@nivogroepholland.nl
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@zonlio.nl
SMTP_PASSWORD=

# Alleen instellen nadat het aantal vertrouwde reverse proxies is vastgesteld.
TRUST_PROXY_HOPS=
# De prijs- en weerfeed hebben voor deze configuratie geen API-key nodig.
MET_USER_AGENT=Zonlio/1.0 info@zonlio.nl

# Alleen na echte verbinding-/afleverproef en expliciete operationele vrijgave aanzetten.
MEMBER_ACCOUNTS_ENABLED=false
DAYMAIL_SIGNUP_ENABLED=false
DAYMAIL_SEND_ENABLED=false
# Bevestigd uitgaand quotum per rollende 24 uur. 0 blokkeert nieuwe account-/dagmaildiensten.
# Reserveer extra ruimte voor handmatige mail buiten Zonlio. 20% blijft voor niet-dagmail.
SMTP_DAILY_LIMIT=0
# Beheer-noodstop: stopt alle mailtypes zonder opgeslagen dossiers te verwijderen.
MAIL_SEND_PAUSED=false
# Zet na croninstallatie true om ontbrekende/late ticks als storing te signaleren.
OPS_EXPECT_CRON=false
# Operationele waarschuwingen, geen commerciële berichten. Alleen goedgekeurde beheerinbox.
OPS_ALERTS_ENABLED=false
OPS_ALERT_TO=info@zonlio.nl
# Alleen na akkoord op 90-dagenbewaarbeleid voor pseudonieme interacties.
ANALYTICS_RETENTION_CONFIRMED=false
# NIVO Portal mag pas na implementatie van het beschreven claim/ack-contract verbinden.
PORTAL_EXPORT_ENABLED=false
PORTAL_EXPORT_TOKEN=
